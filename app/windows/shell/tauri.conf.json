{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Canopus",
  "version": "0.6.0",
  "identifier": "pt.brunomonte.startracker",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Canopus",
        "width": 1400,
        "height": 900,
        "minWidth": 390,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#0f1a2e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Bruno Monte",
    "shortDescription": "Canopus head and Sony camera control",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend/dist/startracker-backend/": "backend/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}